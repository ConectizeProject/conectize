# Copie para .env.local — nunca commite .env com segredos.
# Supabase: Settings → API | Auth redirect: {SITE_URL}/portal/auth/callback
# Evolution Docker: infra/evolution-api/env.example.txt

# --- Obrigatório ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Em produção use https://www.conectize.com.br (host canônico)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron (Vercel) ---
CRON_SECRET=

# --- Bling (opcional) ---
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# BLING_REDIRECT_URI=
# BLING_OAUTH_SCOPE=
# BLING_WEBHOOK_SECRET=
# BLING_ACCESS_TOKEN_REFRESH_MARGIN_MINUTES=30

# --- WhatsApp Meta (opcional) ---
# WHATSAPP_APP_SECRET=
# META_APP_SECRET=
# WHATSAPP_GRAPH_API_VERSION=v21.0

# --- WhatsApp Evolution (opcional) ---
WHATSAPP_EVOLUTION_API_URL=http://localhost:8080
WHATSAPP_EVOLUTION_API_KEY=
WHATSAPP_EVOLUTION_WEBHOOK_SECRET=
# Webhook no Docker Windows: http://host.docker.internal:3000/api/webhooks/whatsapp-evolution

# --- Relay /pix (opcional) ---
# WHATSAPP_PIX_RELAY_ENABLED=true
# WHATSAPP_PIX_RELAY_INSTANCE_NAME=
# WHATSAPP_PIX_RELAY_GROUP_JID=
# WHATSAPP_PIX_RELAY_OWNER=
# WHATSAPP_PIX_RELAY_ALLOWED=

# --- Outros (opcional) ---
# WHATSAPP_MEDIA_TTL_HOURS=72
# OPENAI_API_KEY=
